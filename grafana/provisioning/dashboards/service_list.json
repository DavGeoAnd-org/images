                        "rawQuery": true,
                        "rawSql": "SELECT \"service.name\" \"service\",\"deployment.environment\" \"environment\",\nSELECTOR_LAST(\"git.branch\", time)['value'] \"branch\",\nSELECTOR_LAST(\"git.commit.id.abbrev\", time)['value'] \"last commit\",\n  (SELECT COUNT(DISTINCT \"container.id\") \"tasks running\"\n  FROM \"event.added\"\n  WHERE \"service.name\"=\"service.info\".\"service.name\" AND \"deployment.environment\"=\"service.info\".\"deployment.environment\" AND $__timeFilter(time))\nFROM \"service.info\"\nWHERE \"service.name\" IN (${service:singlequote}) AND \"deployment.environment\" IN (${environment:singlequote})\nGROUP BY \"service.name\",\"deployment.environment\"\nORDER BY \"service.name\",\"deployment.environment\"",
